---
// src/components/CtaFinal.astro
---

<section id="cta-final" class="py-24 relative overflow-hidden bg-[#0a0a0f]">
  {/* Glow de fondo base */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-gradient-to-r from-[#a100ff]/20 to-[#437ceb]/20 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10">
    
    {/* --- INICIO DEL CONTENEDOR CON MAGIC BORDER --- */}
    <div class="max-w-6xl mx-auto relative p-[1px] rounded-[42px] overflow-hidden group">
      
      {/* 1. La Capa Animada (El haz de luz giratorio) */}
      <div class="absolute inset-[-100%] animate-[spin_4s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,transparent_0%,transparent_40%,#437ceb_70%,#a100ff_100%)] opacity-70 group-hover:opacity-100 transition-opacity duration-500"></div>

      {/* 2. La Tarjeta Principal (Tapa el centro del haz de luz, dejando ver solo el borde de 1px) */}
      <div class="relative w-full h-full bg-[#0a0a0f]/95 backdrop-blur-2xl rounded-[40px] p-8 md:p-16 text-center shadow-2xl z-10">
        
        {/* Glow sutil en el interior de la tarjeta */}
        <div class="absolute inset-0 bg-gradient-to-br from-white/[0.03] to-transparent rounded-[40px]"></div>

        <div class="relative z-20">
          <h2 class="font-poppins text-4xl md:text-6xl font-bold text-white mb-6 leading-tight tracking-tighter">
            ¿Listo para conocer<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#a100ff] to-[#437ceb]">
              a tu nuevo empelado estrella?
            </span>
          </h2>
          
          <p class="font-gilroy text-xl text-gray-400 max-w-2xl mx-auto mb-10 leading-relaxed">
            30 minutos. Te mostramos <span class="text-white">DOMA</span> en acción y construimos el caso de negocio para tu industria.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-5 mb-12">
            {/* Botón actualizado con el link de WhatsApp y target="_blank" */}
            <a 
              href="https://wa.me/5213310736395?text=Hola,%20estoy%20listo%20para%20ver%20al%20Digital%20Sales%20Executive%20en%20acción.%20Quiero%20agendar%20mis%2030%20minutos." 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full sm:w-auto px-10 py-5 rounded-full bg-white text-[#0a0a0f] font-gilroy font-black text-lg hover:scale-105 transition-all shadow-[0_0_30px_rgba(255,255,255,0.15)] active:scale-95"
            >
              Agenda una demo
            </a>
          </div>

          <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 border-t border-white/5 pt-8">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-[#a100ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-gray-300 font-gilroy text-sm font-bold uppercase tracking-widest">Sin compromiso</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-[#a100ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-gray-300 font-gilroy text-sm font-bold uppercase tracking-widest">Demo personalizada</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-[#a100ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-gray-300 font-gilroy text-sm font-bold uppercase tracking-widest">Propuesta en 48h</span>
            </div>
          </div>
        </div>

      </div>
    </div>
    {/* --- FIN DEL CONTENEDOR --- */}

  </div>
</section>