---
// src/pages/components/ScrollToTop.astro
---

<button
  id="scroll-to-top"
  aria-label="Volver al inicio"
  class="fixed bottom-8 left-8 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#0a0a0f]/80 text-white shadow-2xl backdrop-blur-sm border border-white/10 transition-all duration-300 ease-in-out hover:bg-white hover:text-black hover:scale-110 active:scale-95 group shadow-[0_0_20px_rgba(67,124,235,0.1)] hover:shadow-[0_0_30px_rgba(67,124,235,0.3)]"
>
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke="currentColor" 
    stroke-width="2.5" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class="h-6 w-6 transition-transform group-hover:-translate-y-1"
  >
    <path d="m18 15-6-6-6 6"/>
  </svg>
</button>

<script>
  // Astro ejecuta este script automáticamente al cargar la página
  const btn = document.getElementById('scroll-to-top');

  if (btn) {
    // Escondemos el botón por JavaScript al cargar la página si estamos hasta arriba
    if (window.scrollY < 400) {
      btn.style.opacity = '0';
      btn.style.pointerEvents = 'none';
      btn.style.transform = 'translateY(20px)';
    }

    // Escuchamos el scroll
    window.addEventListener('scroll', () => {
      // Agregamos un console.log para que puedas ver en la consola si está detectando el movimiento
      console.log('Posición del scroll:', window.scrollY); 

      if (window.scrollY > 400) {
        btn.style.opacity = '1';
        btn.style.pointerEvents = 'auto';
        btn.style.transform = 'translateY(0)';
      } else {
        btn.style.opacity = '0';
        btn.style.pointerEvents = 'none';
        btn.style.transform = 'translateY(20px)';
      }
    });

    // Acción de subir
    btn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }
</script>