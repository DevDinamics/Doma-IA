---
import '../styles/global.css';
import WhatsAppWidget from '../components/WhatsAppWidget.jsx';
import ScrollToTop from '../components/ScrollToTop.astro';

// 1. Props estrictas y ampliadas
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string | URL;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  customSchema?: Record<string, any> | Array<Record<string, any>>;
}

const siteDomain = "https://domahumans.com";

const { 
  title, 
  description = "DOMA: El primer Digital Sales Executive para espacios físicos. IA que conecta el conocimiento completo de tu empresa en tiempo real.", 
  image = "/portada-doma.jpg", 
  canonicalURL = new URL(Astro.url.pathname, siteDomain).href,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  author = "DOMA",
  customSchema
} = Astro.props;

// Normalización de Título de Marca
const formattedTitle = title.toLowerCase().includes("doma") ? title : `${title} | DOMA IA`;

// Construcción segura de URLs absolutas
const canonical = typeof canonicalURL === 'string' ? canonicalURL : canonicalURL.href;
const socialImageURL = new URL(image, siteDomain).href;

// Esquema Global Organization
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteDomain}/#organization`,
  "name": "DOMA",
  "url": siteDomain,
  "logo": {
    "@type": "ImageObject",
    "url": `${siteDomain}/DOMA_Isotipo.svg`
  },
  "description": "Digital Sales Executive impulsado por IA para espacios físicos.",
  "sameAs": [
    "https://www.linkedin.com/company/domahumans/"
  ]
};
---

<!doctype html>
<html lang="es" class="scroll-smooth dark">
  <head>
    <!-- Script crítico anti-parpadeo de tema (Ejecución inmediata en el DOM) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'dark'; // Predeterminado en oscuro
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>

    <!-- Preconnect / DNS-Prefetch para Core Web Vitals -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-PV376BQT');
    </script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0f" id="meta-theme-color" />

    {/* --- SITEMAP --- */}
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* --- FAVICONS & ICONS --- */}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/DOMA_Isotipo.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/DOMA_Isotipo_32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/DOMA_Isotipo_180x180.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/DOMA_Isotipo_512x512.png" />

    {/* --- SEO BÁSICO & INDEXACIÓN --- */}
    <title>{formattedTitle}</title>
    <meta name="description" content={description} />
    <meta 
      name="robots" 
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} 
    />
    <meta name="google-site-verification" content="6uzRu5H_OgKKRfGjoaVd4AhM6_DeXd0Lc6thFvs-E9k" />
    <link rel="canonical" href={canonical} />

    {/* --- OPEN GRAPH --- */}
    <meta property="og:site_name" content="DOMA" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={formattedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:secure_url" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={formattedTitle} />

    {type === 'article' && (
      <>
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
        {author && <meta property="article:author" content={author} />}
      </>
    )}

    {/* --- TWITTER CARDS --- */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={formattedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={formattedTitle} />

    {/* --- SCHEMA MARKUP --- */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    
    {customSchema && (
      <script 
        is:inline
        type="application/ld+json" 
        set:html={JSON.stringify(customSchema)} 
      />
    )}

    <slot name="head" />
  </head>
  <body class="bg-slate-50 text-slate-900 dark:bg-[#0a0a0f] dark:text-white font-gilroy antialiased overflow-x-hidden transition-colors duration-300">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PV376BQT"
      height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <slot />
    <ScrollToTop />
  </body>
</html>