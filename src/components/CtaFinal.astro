---
// src/components/CtaFinal.astro
---

<section id="cta-final" class="py-24 relative overflow-hidden bg-slate-50 dark:bg-[#0a0a0f] transition-colors duration-300">
  {/* Glow de fondo base */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-gradient-to-r from-[#a100ff]/15 to-[#437ceb]/15 dark:from-[#a100ff]/20 dark:to-[#437ceb]/20 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10">
    
    {/* --- INICIO DEL CONTENEDOR CON MAGIC BORDER --- */}
    <div class="max-w-6xl mx-auto relative p-[1px] rounded-[42px] overflow-hidden group shadow-[0_20px_50px_rgba(0,0,0,0.08)] dark:shadow-2xl">
      
      {/* 1. La Capa Animada (El haz de luz giratorio) */}
      <div class="absolute inset-[-100%] animate-[spin_4s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,transparent_0%,transparent_40%,#437ceb_70%,#a100ff_100%)] opacity-70 group-hover:opacity-100 transition-opacity duration-500"></div>

      {/* 2. La Tarjeta Principal (Tapa el centro del haz de luz, dejando ver solo el borde de 1px) */}
      <div class="relative w-full h-full bg-white/95 dark:bg-[#0a0a0f]/95 backdrop-blur-2xl rounded-[40px] p-8 md:p-16 text-center z-10 transition-colors duration-300">
        
        {/* Glow sutil en el interior de la tarjeta */}
        <div class="absolute inset-0 bg-gradient-to-br from-black/[0.02] to-transparent dark:from-white/[0.03] dark:to-transparent rounded-[40px] pointer-events-none"></div>

        <div class="relative z-20">
          <h2 class="font-poppins text-4xl md:text-6xl font-bold text-slate-900 dark:text-white mb-6 leading-tight tracking-tighter transition-colors duration-300">
            ¿Listo para conocer a <br class="hidden sm:block" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#a100ff] to-[#437ceb]">
              tu próximo empleado estrella?
            </span>
          </h2>
          
          <p class="font-gilroy text-lg md:text-xl text-slate-600 dark:text-gray-300 max-w-2xl mx-auto mb-10 leading-relaxed transition-colors duration-300">
            Conoce cómo opera <span class="text-[#a100ff] font-bold">DOMA</span> en situaciones reales. Completa el formulario y accede a una demo para que interactues en tiempo real con  <span class="text-[#a100ff] font-bold">DOMA</span>.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-5 mb-12">
            <a 
              id="btn-agenda-demo"
              href="https://wa.me/5213310736395?text=Hola,%20estoy%20listo%20para%20ver%20al%20Digital%20Sales%20Executive%20en%20acción.%20Quiero%20solicitar%20una%20demo." 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full sm:w-auto px-10 py-5 rounded-full bg-slate-900 text-white dark:bg-white dark:text-[#0a0a0f] font-gilroy font-black text-lg hover:scale-105 transition-all shadow-[0_10px_25px_rgba(0,0,0,0.15)] dark:shadow-[0_0_30px_rgba(255,255,255,0.15)] active:scale-95 cursor-pointer"
            >
              Solicita una demo
            </a>
          </div>

          
        </div>

      </div>
    </div>
    {/* --- FIN DEL CONTENEDOR --- */}

  </div>
</section>