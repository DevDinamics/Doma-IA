---
// src/components/CtaFinal.astro
---

<section id="cta-final" class="py-24 relative overflow-hidden bg-slate-50 dark:bg-[#0a0a0f]">
  {/* Glow de fondo base */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-gradient-to-r from-[#a100ff]/15 to-[#437ceb]/15 dark:from-[#a100ff]/20 dark:to-[#437ceb]/20 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10">
    
    {/* --- CONTENEDOR CON MAGIC BORDER --- */}
    <div class="max-w-6xl mx-auto relative p-[1px] rounded-[42px] overflow-hidden group shadow-[0_20px_50px_rgba(0,0,0,0.08)] dark:shadow-2xl">
      
      {/* 1. Capa animada con haz de luz */}
      <div class="absolute inset-[-100%] animate-[spin_4s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,transparent_0%,transparent_40%,#437ceb_70%,#a100ff_100%)] opacity-70 group-hover:opacity-100 transition-opacity duration-500"></div>

      {/* 2. Tarjeta Principal */}
      <div class="relative w-full h-full bg-white/95 dark:bg-[#0a0a0f]/95 backdrop-blur-2xl rounded-[40px] p-8 md:p-16 text-center z-10">
        
        <div class="absolute inset-0 bg-gradient-to-br from-black/[0.02] to-transparent dark:from-white/[0.03] dark:to-transparent rounded-[40px] pointer-events-none"></div>

        <div class="relative z-20">
          <h2 class="font-poppins font-bold text-4xl md:text-6xl text-slate-900 dark:text-white mb-6 leading-tight tracking-tighter">
            ¿Listo para conocer a <br class="hidden sm:block" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#a100ff] to-[#437ceb]">
              tu próximo empleado estrella?
            </span>
          </h2>
          
          <p class="font-gilroy font-normal text-lg md:text-xl text-slate-600 dark:text-gray-300 max-w-2xl mx-auto mb-10 leading-relaxed">
            Conoce cómo opera <span class="text-[#a100ff] font-bold">DOMA</span> en situaciones reales. Completa el formulario y accede a una demo para interactuar en tiempo real con <span class="text-[#a100ff] font-bold">DOMA</span>.
          </p>

          {/* Botón que detona el Modal (reemplaza WhatsApp) */}
          <div class="flex items-center justify-center mb-4">
            <button 
              id="open-modal-demo-btn"
              type="button"
              class="w-full sm:w-auto px-10 py-5 rounded-full bg-slate-900 text-white dark:bg-white dark:text-[#0a0a0f] font-poppins font-semibold text-lg hover:scale-105 transition-all shadow-[0_10px_25px_rgba(0,0,0,0.15)] dark:shadow-[0_0_30px_rgba(255,255,255,0.15)] active:scale-95 cursor-pointer"
            >
              Agenda una demo
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>

  {/* ========================================================= */}
  {/* MODAL: FORMULARIO DE AGENDAR DEMO                         */}
  {/* ========================================================= */}
  <div 
    id="demo-modal" 
    class="fixed inset-0 z-[99999] bg-slate-950/70 backdrop-blur-md flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
  >
    <div 
      id="demo-modal-card"
      class="relative w-full max-w-xl bg-white dark:bg-[#12111c] border border-slate-200 dark:border-white/10 rounded-3xl p-6 sm:p-9 shadow-2xl transform scale-95 transition-transform duration-300 max-h-[92vh] overflow-y-auto"
    >
      {/* Botón Cerrar Modal */}
      <button 
        id="close-modal-demo-btn"
        type="button" 
        class="absolute top-5 right-5 w-9 h-9 rounded-full bg-slate-100 dark:bg-white/10 text-slate-500 hover:text-slate-900 dark:text-gray-400 dark:hover:text-white flex items-center justify-center transition-colors cursor-pointer"
        aria-label="Cerrar modal"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      {/* VISTA 1: FORMULARIO */}
      <div id="modal-form-view">
        <div class="mb-6">
          <span class="text-[#a100ff] text-xs font-poppins font-semibold uppercase tracking-widest block mb-1">
            DEMO EXCLUSIVA
          </span>
          <h3 class="font-poppins font-bold text-2xl sm:text-3xl text-slate-900 dark:text-white tracking-tight">
            Agenda tu sesión con DOMA
          </h3>
          <p class="font-gilroy font-normal text-xs sm:text-sm text-slate-500 dark:text-gray-400 mt-1">
            Todos los campos son obligatorios para validar tu solicitud.
          </p>
        </div>

        <form id="demo-form" class="space-y-4 text-left">
          {/* Mensaje de error global */}
          <div id="form-error-msg" class="hidden p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-500 text-xs font-gilroy font-semibold"></div>

          {/* Campo: Nombre completo */}
          <div>
            <label class="block font-poppins font-semibold text-xs text-slate-700 dark:text-gray-300 mb-1.5" for="form-nombre">
              Nombre completo *
            </label>
            <input 
              type="text" 
              id="form-nombre" 
              name="nombre" 
              required 
              placeholder="Ej. Carlos Valadez" 
              class="w-full px-4 py-3 rounded-xl bg-slate-100 dark:bg-white/5 border border-slate-300 dark:border-white/10 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-gray-500 text-sm font-gilroy outline-none focus:border-[#a100ff] focus:ring-1 focus:ring-[#a100ff] transition-all"
            />
          </div>

          {/* Campo: Correo corporativo (Con restricción de dominios personales) */}
          <div>
            <label class="block font-poppins font-semibold text-xs text-slate-700 dark:text-gray-300 mb-1.5" for="form-email">
              Correo corporativo *
            </label>
            <input 
              type="email" 
              id="form-email" 
              name="email" 
              required 
              placeholder="nombre@tuempresa.com" 
              class="w-full px-4 py-3 rounded-xl bg-slate-100 dark:bg-white/5 border border-slate-300 dark:border-white/10 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-gray-500 text-sm font-gilroy outline-none focus:border-[#a100ff] focus:ring-1 focus:ring-[#a100ff] transition-all"
            />
            <span id="email-warning" class="hidden text-[11px] font-gilroy text-red-500 mt-1 block">
              Por favor usa tu correo empresarial (no Gmail, Yahoo o Hotmail).
            </span>
          </div>

          {/* Fila doble: Nombre de empresa y Puesto */}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label class="block font-poppins font-semibold text-xs text-slate-700 dark:text-gray-300 mb-1.5" for="form-empresa">
                Nombre de empresa *
              </label>
              <input 
                type="text" 
                id="form-empresa" 
                name="empresa" 
                required 
                placeholder="Ej. Corporativo Retail" 
                class="w-full px-4 py-3 rounded-xl bg-slate-100 dark:bg-white/5 border border-slate-300 dark:border-white/10 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-gray-500 text-sm font-gilroy outline-none focus:border-[#a100ff] focus:ring-1 focus:ring-[#a100ff] transition-all"
              />
            </div>

            <div>
              <label class="block font-poppins font-semibold text-xs text-slate-700 dark:text-gray-300 mb-1.5" for="form-puesto">
                Puesto *
              </label>
              <input 
                type="text" 
                id="form-puesto" 
                name="puesto" 
                required 
                placeholder="Ej. Director de Operaciones" 
                class="w-full px-4 py-3 rounded-xl bg-slate-100 dark:bg-white/5 border border-slate-300 dark:border-white/10 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-gray-500 text-sm font-gilroy outline-none focus:border-[#a100ff] focus:ring-1 focus:ring-[#a100ff] transition-all"
              />
            </div>
          </div>

          {/* Menú desplegable: Tamaño de empresa (Rangos a partir de 200) */}
          <div>
            <label class="block font-poppins font-semibold text-xs text-slate-700 dark:text-gray-300 mb-1.5" for="form-tamano">
              número de empleados*
            </label>
            <select 
              id="form-tamano" 
              name="tamano" 
              required 
              class="w-full px-4 py-3 rounded-xl bg-slate-100 dark:bg-[#191825] border border-slate-300 dark:border-white/10 text-slate-900 dark:text-white text-sm font-gilroy outline-none focus:border-[#a100ff] focus:ring-1 focus:ring-[#a100ff] transition-all cursor-pointer"
            >
              <option value="" disabled selected>Selecciona un rango de empleados</option>
              <option value="200-500">200-500 empleados</option>
              <option value="501-1,000">501-1,000 empleados</option>
              <option value="1,001-5,000">1,001-5,000 empleados</option>
              <option value="5,001-10,000">5,001-10,000 empleados</option>
              <option value="10,001+">10,001+ empleados</option>
            </select>
          </div>

          <button 
            id="form-submit-btn"
            type="submit"
            class="w-full py-4 rounded-xl bg-gradient-to-r from-[#a100ff] to-[#437ceb] text-white font-poppins font-semibold text-sm shadow-[0_0_20px_rgba(161,0,255,0.4)] hover:brightness-110 active:scale-[0.98] transition-all cursor-pointer mt-2"
          >
            Enviar solicitud
          </button>
        </form>
      </div>

      {/* VISTA 2: POP-UP DE CONFIRMACIÓN */}
      <div id="modal-success-view" class="hidden py-8 px-2 text-center flex-col items-center">
        <div class="w-16 h-16 rounded-full bg-gradient-to-tr from-[#a100ff] to-[#437ceb] flex items-center justify-center text-white mb-5 shadow-[0_0_25px_rgba(161,0,255,0.5)] animate-bounce-soft">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h4 class="font-poppins font-bold text-2xl text-slate-900 dark:text-white mb-2">
          ¡Solicitud confirmada!
        </h4>
        <p class="font-gilroy font-normal text-sm text-slate-600 dark:text-gray-300 max-w-sm mb-6 leading-relaxed">
          Hemos recibido los datos de tu empresa. El equipo de DOMA se pondrá en contacto a tu correo corporativo para coordinar la sesión.
        </p>
        <button 
          id="modal-success-close-btn"
          type="button"
          class="px-8 py-3 rounded-full bg-slate-900 text-white dark:bg-white dark:text-[#0a0a0f] font-poppins font-semibold text-xs tracking-wider uppercase hover:opacity-90 transition-opacity"
        >
          Entendido
        </button>
      </div>

    </div>
  </div>
</section>

<script>
  // Control de Apertura y Cierre de Modal
  const openModalBtn = document.getElementById('open-modal-demo-btn');
  const closeModalBtn = document.getElementById('close-modal-demo-btn');
  const successCloseBtn = document.getElementById('modal-success-close-btn');
  const modal = document.getElementById('demo-modal');
  const modalCard = document.getElementById('demo-modal-card');
  const form = document.getElementById('demo-form') as HTMLFormElement;
  const formView = document.getElementById('modal-form-view');
  const successView = document.getElementById('modal-success-view');
  const emailInput = document.getElementById('form-email') as HTMLInputElement;
  const emailWarning = document.getElementById('email-warning');
  const errorMsg = document.getElementById('form-error-msg');
  const submitBtn = document.getElementById('form-submit-btn');

  // Conectar también cualquier botón externo de "Agendar Demo" (ej. Navbar / Footer)
  document.querySelectorAll('a[href="#cta-final"], a[href^="https://wa.me/"]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openModal();
    });
  });

  function openModal() {
    modal?.classList.remove('opacity-0', 'pointer-events-none');
    modal?.classList.add('opacity-100', 'pointer-events-auto');
    modalCard?.classList.remove('scale-95');
    modalCard?.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal?.classList.remove('opacity-100', 'pointer-events-auto');
    modal?.classList.add('opacity-0', 'pointer-events-none');
    modalCard?.classList.remove('scale-100');
    modalCard?.classList.add('scale-95');
    document.body.style.overflow = '';
    
    // Resetear vistas tras cerrar
    setTimeout(() => {
      form?.reset();
      formView?.classList.remove('hidden');
      successView?.classList.add('hidden');
      successView?.classList.remove('flex');
      errorMsg?.classList.add('hidden');
      emailWarning?.classList.add('hidden');
    }, 300);
  }

  openModalBtn?.addEventListener('click', openModal);
  closeModalBtn?.addEventListener('click', closeModal);
  successCloseBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Lista de dominios personales bloqueados
  const blockedDomains = [
    'gmail.com', 'googlemail.com', 'yahoo.com', 'yahoo.es', 'hotmail.com',
    'outlook.com', 'live.com', 'icloud.com', 'proton.me', 'protonmail.com',
    'aol.com', 'zoho.com', 'mail.com'
  ];

  function validateEmailDomain(email: string): boolean {
    const parts = email.split('@');
    if (parts.length !== 2) return false;
    const domain = parts[1].toLowerCase().trim();
    return !blockedDomains.includes(domain);
  }

  emailInput?.addEventListener('input', () => {
    if (emailInput.value.includes('@')) {
      if (!validateEmailDomain(emailInput.value)) {
        emailWarning?.classList.remove('hidden');
      } else {
        emailWarning?.classList.add('hidden');
      }
    } else {
      emailWarning?.classList.add('hidden');
    }
  });

  // Envío AJAX al PHP
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg?.classList.add('hidden');

    const email = emailInput.value.trim();
    if (!validateEmailDomain(email)) {
      emailWarning?.classList.remove('hidden');
      emailInput.focus();
      return;
    }

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    if (submitBtn) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.textContent = 'Enviando solicitud...';
    }

    try {
      const response = await fetch('/send-mail.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const res = await response.json();

      if (response.ok && res.success) {
        // Transición a la vista Pop-up de confirmación
        formView?.classList.add('hidden');
        successView?.classList.remove('hidden');
        successView?.classList.add('flex');
      } else {
        if (errorMsg) {
          errorMsg.textContent = res.message || 'Ocurrió un error al enviar. Intenta nuevamente.';
          errorMsg.classList.remove('hidden');
        }
      }
    } catch {
      if (errorMsg) {
        errorMsg.textContent = 'No fue posible conectar con el servidor de correos.';
        errorMsg.classList.remove('hidden');
      }
    } finally {
      if (submitBtn) {
        submitBtn.removeAttribute('disabled');
        submitBtn.textContent = 'Enviar solicitud';
      }
    }
  });
</script>