---
// src/components/Navbar.astro
---

{/* HEADER CONTENEDOR: Maneja el padding superior animado */}
<header id="header-container" class="fixed top-0 inset-x-0 z-[9999] flex justify-center pointer-events-none transition-all duration-500 pt-0">
  
  {/* LA BARRA / ISLA FLOTANTE */}
  <div id="navbar" class="pointer-events-auto w-full h-16 transition-all duration-500 z-50 
    max-w-none rounded-none border-b border-black/5 dark:border-white/5 bg-transparent backdrop-blur-none"
  >
    
    <div class="w-full max-w-5xl mx-auto px-6 sm:px-8 h-full flex items-center justify-between">
      
      {/* LOGO */}
      <a href="/" class="relative z-50 flex items-center">
        <img 
          src="/Logo_domanav.png" 
          alt="DOMA Logo" 
          class="h-4 sm:h-6 w-auto object-contain brightness-0 dark:brightness-100 transition-[filter] duration-300"
        />
      </a>

      {/* LINKS ESCRITORIO */}
      <nav class="hidden md:flex items-center gap-8">
        <a href="#producto" class="text-sm font-gilroy font-semibold text-slate-700 hover:text-black dark:text-gray-300 dark:hover:text-white transition-colors relative group">
          Producto
          <span class="absolute -bottom-1 left-0 w-0 h-[2px] bg-[#a100ff] transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a href="#industrias" class="text-sm font-gilroy font-semibold text-slate-700 hover:text-black dark:text-gray-300 dark:hover:text-white transition-colors relative group">
          Industrias
          <span class="absolute -bottom-1 left-0 w-0 h-[2px] bg-[#437ceb] transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a href="#modelo" class="text-sm font-gilroy font-semibold text-slate-700 hover:text-black dark:text-gray-300 dark:hover:text-white transition-colors relative group">
          Modelo
          <span class="absolute -bottom-1 left-0 w-0 h-[2px] bg-[#906ef7] transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a href="#faq" class="text-sm font-gilroy font-semibold text-slate-700 hover:text-black dark:text-gray-300 dark:hover:text-white transition-colors relative group">
          FAQ
          <span class="absolute -bottom-1 left-0 w-0 h-[2px] bg-[#111827] dark:bg-white transition-all duration-300 group-hover:w-full"></span>
        </a>
      </nav>

      {/* BOTÓN THEME TOGGLE, CTA Y MENÚ MÓVIL */}
      <div class="flex items-center gap-3 sm:gap-4 z-50">
        
        {/* BOTÓN SELECTOR DE TEMA */}
        <button 
          id="theme-toggle" 
          type="button" 
          aria-label="Cambiar tema"
          class="w-9 h-9 rounded-full flex items-center justify-center bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-slate-800 dark:text-gray-300 hover:text-black dark:hover:text-white hover:bg-black/10 dark:hover:bg-white/10 active:scale-90 transition-all duration-300 backdrop-blur-md cursor-pointer"
        >
          {/* Icono de Sol */}
          <svg id="theme-icon-sun" class="w-4 h-4 transition-transform duration-300 rotate-0 scale-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"></circle>
            <path stroke-linecap="round" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
          </svg>

          {/* Icono de Luna */}
          <svg id="theme-icon-moon" class="w-4 h-4 hidden transition-transform duration-300 -rotate-90 scale-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        {/* Botón CTA */}
        <a 
          href="#cta-final" 
          class="hidden md:flex items-center justify-center px-5 py-2 rounded-full bg-slate-900 text-white dark:bg-white/5 dark:border dark:border-white/10 dark:text-white text-sm font-gilroy font-bold hover:bg-[#a100ff] dark:hover:bg-[#a100ff] hover:text-white transition-all duration-300 shadow-sm dark:shadow-none backdrop-blur-md"
        >
          Agendar Demo
        </a>

        {/* Botón Hamburguesa */}
        <button id="mobile-menu-btn" class="md:hidden text-slate-900 dark:text-white focus:outline-none ml-1 pointer-events-auto relative z-50" aria-label="Abrir menú">
          <svg id="icon-menu" class="w-6 h-6 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  {/* OVERLAY DEL MENÚ MÓVIL */}
  <div id="mobile-menu-overlay" class="fixed inset-0 bg-slate-50/95 dark:bg-[#0a0a0f]/95 backdrop-blur-3xl z-40 opacity-0 pointer-events-none transition-opacity duration-300 flex flex-col pt-32 px-6">
    <nav class="flex flex-col gap-8">
      <a href="#producto" class="mobile-link text-3xl font-poppins font-semibold text-slate-900 dark:text-white hover:text-[#a100ff] transition-colors">Producto</a>
      <a href="#industrias" class="mobile-link text-3xl font-poppins font-semibold text-slate-900 dark:text-white hover:text-[#437ceb] transition-colors">Industrias</a>
      <a href="#modelo" class="mobile-link text-3xl font-poppins font-semibold text-slate-900 dark:text-white hover:text-[#906ef7] transition-colors">Modelo</a>
      <a href="#faq" class="mobile-link text-3xl font-poppins font-semibold text-slate-900 dark:text-white hover:text-[#a100ff] transition-colors">FAQ</a>
      
      <div class="h-px w-full bg-black/10 dark:bg-white/10 my-4"></div>
      
      <a href="#cta-final" class="mobile-link w-full text-center py-4 rounded-full bg-gradient-to-r from-[#a100ff] to-[#437ceb] text-white font-gilroy font-bold text-lg shadow-[0_0_20px_rgba(161,0,255,0.3)]">
        Agendar Demo
      </a>
    </nav>
  </div>
</header>

<script lang="ts">
  const headerContainer = document.getElementById('header-container');
  const navbar = document.getElementById('navbar');

  const updateNavbarScroll = () => {
    const isDark = document.documentElement.classList.contains('dark');
    
    if (window.scrollY > 20) {
      headerContainer?.classList.remove('pt-0', 'px-0');
      headerContainer?.classList.add('pt-4', 'sm:pt-6', 'px-4');

      navbar?.classList.remove('max-w-none', 'rounded-none', 'border-b', 'border-black/5', 'border-white/5', 'bg-transparent', 'backdrop-blur-none');
      navbar?.classList.add('max-w-5xl', 'rounded-full', 'border', 'backdrop-blur-2xl');

      if (isDark) {
        navbar?.classList.remove('border-slate-200/80', 'bg-white/70', 'shadow-[0_8px_32px_rgba(0,0,0,0.08)]');
        navbar?.classList.add('border-white/10', 'bg-white/[0.05]', 'shadow-[0_8px_32px_rgba(0,0,0,0.5)]');
      } else {
        navbar?.classList.remove('border-white/10', 'bg-white/[0.05]', 'shadow-[0_8px_32px_rgba(0,0,0,0.5)]');
        navbar?.classList.add('border-slate-200/80', 'bg-white/70', 'shadow-[0_8px_32px_rgba(0,0,0,0.08)]');
      }
    } else {
      headerContainer?.classList.add('pt-0', 'px-0');
      headerContainer?.classList.remove('pt-4', 'sm:pt-6', 'px-4');

      navbar?.classList.remove(
        'max-w-5xl', 'rounded-full', 'border', 'backdrop-blur-2xl',
        'border-white/10', 'bg-white/[0.05]', 'shadow-[0_8px_32px_rgba(0,0,0,0.5)]',
        'border-slate-200/80', 'bg-white/70', 'shadow-[0_8px_32px_rgba(0,0,0,0.08)]'
      );
      navbar?.classList.add('max-w-none', 'rounded-none', 'border-b', isDark ? 'border-white/5' : 'border-black/5', 'bg-transparent', 'backdrop-blur-none');
    }
  };

  window.addEventListener('scroll', updateNavbarScroll, { passive: true });

  const btn = document.getElementById('mobile-menu-btn');
  const overlay = document.getElementById('mobile-menu-overlay');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  let isMenuOpen = false;

  function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    if (isMenuOpen) {
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
      overlay?.classList.add('opacity-100', 'pointer-events-auto');
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      document.body.style.overflow = 'hidden'; 
    } else {
      overlay?.classList.remove('opacity-100', 'pointer-events-auto');
      overlay?.classList.add('opacity-0', 'pointer-events-none');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = ''; 
    }
  }

  btn?.addEventListener('click', toggleMenu);
  mobileLinks.forEach(link => link.addEventListener('click', () => { if (isMenuOpen) toggleMenu(); }));

  const themeToggle = document.getElementById('theme-toggle');
  const iconSun = document.getElementById('theme-icon-sun');
  const iconMoon = document.getElementById('theme-icon-moon');

  const updateIcons = (isDark) => {
    if (isDark) {
      iconSun?.classList.remove('hidden', '-rotate-90', 'scale-0');
      iconSun?.classList.add('rotate-0', 'scale-100');
      iconMoon?.classList.add('hidden', '-rotate-90', 'scale-0');
      iconMoon?.classList.remove('rotate-0', 'scale-100');
    } else {
      iconMoon?.classList.remove('hidden', '-rotate-90', 'scale-0');
      iconMoon?.classList.add('rotate-0', 'scale-100');
      iconSun?.classList.add('hidden', '-rotate-90', 'scale-0');
      iconSun?.classList.remove('rotate-0', 'scale-100');
    }
  };

  const isCurrentDark = document.documentElement.classList.contains('dark');
  updateIcons(isCurrentDark);

  themeToggle?.addEventListener('click', (event) => {
    const target = event.currentTarget;
    const rect = target.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;

    const endRadius = Math.hypot(
      Math.max(x, window.innerWidth - x),
      Math.max(y, window.innerHeight - y)
    );

    if (!document.startViewTransition) {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateIcons(isDark);
      updateNavbarScroll();
      return;
    }

    const transition = document.startViewTransition(() => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateIcons(isDark);
      updateNavbarScroll();
    });

    transition.ready.then(() => {
      const clipPath = [
        `circle(0px at ${x}px ${y}px)`,
        `circle(${endRadius}px at ${x}px ${y}px)`
      ];

      document.documentElement.animate(
        {
          clipPath: clipPath
        },
        {
          duration: 500,
          easing: 'ease-in-out',
          pseudoElement: '::view-transition-new(root)'
        }
      );
    });
  });
</script>