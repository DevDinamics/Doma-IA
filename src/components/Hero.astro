---
// src/components/Hero.astro
---

<section id="hero" class="relative min-h-[100dvh] lg:min-h-screen flex items-center pt-24 pb-16 sm:pt-28 sm:pb-20 lg:pt-20 lg:pb-0 overflow-hidden bg-[#0a0a0f]">
  
  <!-- Luces y efectos ambientales de fondo con cuadrícula -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <div class="absolute top-[-10%] right-[-10%] w-[320px] lg:w-[650px] h-[320px] lg:h-[650px] bg-[#a100ff]/20 rounded-full blur-[100px] lg:blur-[140px] animate-pulse"></div>
    <div class="absolute bottom-[-10%] left-[-10%] w-[280px] lg:w-[550px] h-[280px] lg:h-[550px] bg-[#437ceb]/15 rounded-full blur-[90px] lg:blur-[120px]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:3.5rem_3.5rem] lg:bg-[size:4.5rem_4.5rem] [mask-image:radial-gradient(ellipse:80%_60%_at_50%_40%,#000_75%,transparent_100%)]"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 relative z-10 w-full">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-10 lg:gap-8">      
      
      <!-- Columna izquierda: Textos (ocupa todo el ancho en móvil, centrado o alineado a la izquierda) -->
      <div class="w-full lg:flex-1 flex flex-col items-center text-center lg:items-start lg:text-left max-w-2xl lg:max-w-3xl mx-auto lg:mx-0"> 
        
        <!-- TÍTULO H1 CON LA ANIMACIÓN EXACTA DE REACT BITS (StrokeText + Wipe Fill) -->
        <h1 
          id="hero-stroke-heading"
          class="font-poppins font-bold tracking-tight mb-6 flex flex-col items-center lg:items-start w-full select-none"
          aria-label="El primer empleado digital para espacios físicos."
        >
          <!-- Línea 1: El primer -->
          <span 
            class="stroke-text-line" 
            data-text="El primer" 
            data-stroke="#A78BFA" 
            data-fill="#FFFFFF"
            data-delay="0"
          ></span>

          <!-- Línea 2: empleado digital -->
          <span 
            class="stroke-text-line" 
            data-text="empleado digital" 
            data-stroke="#A78BFA" 
            data-fill="#FFFFFF"
            data-delay="0.22"
          ></span>

          <!-- Línea 3: para -->
          <span 
            class="stroke-text-line" 
            data-text="para" 
            data-stroke="#A78BFA" 
            data-fill="#FFFFFF"
            data-delay="0.44"
          ></span>

          <!-- Línea 4: espacios físicos. (Relleno azul #437ceb y trazo violeta/azul) -->
          <span 
            class="stroke-text-line" 
            data-text="espacios físicos." 
            data-stroke="#A78BFA" 
            data-fill="#437ceb"
            data-delay="0.62"
          ></span>
        </h1>
        
        <!-- Párrafo descriptivo con animación estilo Apple (aparece después del título principal) -->
        <p class="font-gilroy text-base sm:text-lg lg:text-xl text-gray-400 max-w-xl leading-relaxed animate-apple-sequent">
          DOMA conecta el conocimiento completo de tu empresa con un <span class="text-white font-semibold">empleado digital</span>, disponible 24/7. Consistente. Escalable.
        </p>

      </div>

      <!-- Columna derecha: Avatar (Oculto en móvil, escala balanceada en Desktop) -->
      <div class="hidden lg:flex flex-1 w-full relative justify-center items-end self-end max-w-md xl:max-w-lg animate-avatar-enter delay-500">
        <div class="relative w-full flex items-end justify-center h-[460px] lg:h-[520px] xl:h-[600px]">
          
          <!-- Resplandor inferior difuminado -->
          <div class="absolute bottom-2 w-[75%] h-24 bg-gradient-to-t from-[#a100ff]/30 via-[#437ceb]/20 to-transparent rounded-full blur-2xl pointer-events-none z-0"></div>

          <img 
            src="./TOTEM DOMA SITIO 3.webp" 
            alt="DOMA — Digital Sales Executive"
            class="relative z-10 w-auto h-full object-contain object-bottom brightness-105 contrast-110 drop-shadow-[0_10px_35px_rgba(67,124,235,0.3)] transition-transform duration-700 hover:scale-[1.02]"
            style="
              mix-blend-mode: screen;
              -webkit-mask-image: linear-gradient(to bottom, black 0%, black 88%, transparent 100%);
              mask-image: linear-gradient(to bottom, black 0%, black 88%, transparent 100%);
            "
          />
        </div>
      </div>

    </div>
  </div>

  <!-- FLECHA MINIMALISTA INDICADORA DE SCROLL -->
  <a 
    id="scroll-indicator"
    href="#producto"
    aria-label="Hacer scroll hacia abajo"
    class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 text-gray-400/70 hover:text-white transition-all duration-500 cursor-pointer p-2 animate-bounce-soft"
  >
    <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 9l6 6 6-6" />
    </svg>
  </a>
</section>

<script>
  import { gsap } from 'gsap';

  // 1. Lógica de la flecha indicadora de scroll
  const scrollIndicator = document.getElementById('scroll-indicator');

  const handleScroll = () => {
    if (window.scrollY > 25) {
      scrollIndicator?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
    } else {
      scrollIndicator?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });

  // 2. Lógica exacta de React Bits StrokeText (Draw + Wipe Fill + Hover Redraw)
  const STROKE_WIDTH = 1.4;
  const DRAW_DURATION = 1.6;
  const FILL_DELAY = 0.2;
  const STAGGER = 0.05;
  const EASE = 'power2.out';
  const FONT_SIZE = 62; 
  const LETTER_SPACING = -1.5;

  const initStrokeText = () => {
    const lines = document.querySelectorAll('.stroke-text-line');
    const svgNS = 'http://www.w3.org/2000/svg';

    lines.forEach((lineEl, lineIdx) => {
      const text = lineEl.getAttribute('data-text') || '';
      const strokeColor = lineEl.getAttribute('data-stroke') || '#A78BFA';
      const fillColor = lineEl.getAttribute('data-fill') || '#FFFFFF';
      const lineDelay = parseFloat(lineEl.getAttribute('data-delay') || '0');
      const wipeId = `stroke-text-wipe-${lineIdx}`;
      const characters = Array.from(text);

      lineEl.innerHTML = '';

      // Crear SVG
      const svg = document.createElementNS(svgNS, 'svg');
      svg.setAttribute('class', 'stroke-text__svg');
      svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
      svg.setAttribute('aria-hidden', 'true');
      svg.style.visibility = 'hidden';

      // Crear <defs> y <clipPath> para el efecto wipeFrom="left"
      const defs = document.createElementNS(svgNS, 'defs');
      const clipPath = document.createElementNS(svgNS, 'clipPath');
      clipPath.setAttribute('id', wipeId);
      clipPath.setAttribute('clipPathUnits', 'userSpaceOnUse');

      const wipeRect = document.createElementNS(svgNS, 'rect');
      clipPath.appendChild(wipeRect);
      defs.appendChild(clipPath);
      svg.appendChild(defs);

      const fontStyles = {
        fontFamily: 'inherit',
        fontSize: `${FONT_SIZE}px`,
        fontWeight: '800',
        letterSpacing: `${LETTER_SPACING}px`
      };

      // Capa de contorno (Stroke)
      const strokeText = document.createElementNS(svgNS, 'text');
      strokeText.setAttribute('class', 'stroke-text__stroke');
      strokeText.setAttribute('x', '0');
      strokeText.setAttribute('y', '0');
      strokeText.setAttribute('fill', 'none');
      strokeText.setAttribute('stroke', strokeColor);
      strokeText.setAttribute('stroke-width', String(STROKE_WIDTH));
      strokeText.setAttribute('stroke-linejoin', 'round');
      strokeText.setAttribute('stroke-linecap', 'round');
      Object.assign(strokeText.style, fontStyles);

      const strokeSpans: SVGTSpanElement[] = [];
      characters.forEach((char) => {
        const tspan = document.createElementNS(svgNS, 'tspan');
        tspan.setAttribute('data-stroke-char', 'true');
        tspan.textContent = char;
        strokeText.appendChild(tspan);
        strokeSpans.push(tspan);
      });

      // Capa de relleno (Fill con máscara Wipe)
      const fillGroup = document.createElementNS(svgNS, 'g');
      const fillText = document.createElementNS(svgNS, 'text');
      fillText.setAttribute('class', 'stroke-text__fill');
      fillText.setAttribute('x', '0');
      fillText.setAttribute('y', '0');
      fillText.setAttribute('fill', fillColor);
      fillText.setAttribute('stroke', 'none');
      fillText.setAttribute('clip-path', `url(#${wipeId})`);
      Object.assign(fillText.style, fontStyles);

      characters.forEach((char) => {
        const tspan = document.createElementNS(svgNS, 'tspan');
        tspan.setAttribute('data-fill-char', 'true');
        tspan.textContent = char;
        fillText.appendChild(tspan);
      });

      fillGroup.appendChild(fillText);
      svg.appendChild(strokeText);
      svg.appendChild(fillGroup);
      lineEl.appendChild(svg);

      // Medir Bounding Box exacto y animar
      const setupAnimation = () => {
        let bbox;
        try {
          bbox = strokeText.getBBox();
        } catch {
          return;
        }
        if (!bbox || !bbox.width) return;

        const pad = Math.max(STROKE_WIDTH, FONT_SIZE * 0.12);
        const box = {
          x: bbox.x - pad,
          y: bbox.y - pad,
          width: bbox.width + pad * 2,
          height: bbox.height + pad * 2
        };

        svg.setAttribute('viewBox', `${box.x} ${box.y} ${box.width} ${box.height}`);
        (lineEl as HTMLElement).style.setProperty('--stroke-text-aspect', `${box.width / box.height}`);
        svg.style.visibility = 'visible';

        const dash = Math.max(FONT_SIZE * 7, 200);
        const fillDuration = Math.max(0.4, DRAW_DURATION * 0.5);

        const startFrame = { x: box.x, y: box.y, width: 0, height: box.height };
        const endFrame = { x: box.x, y: box.y, width: box.width, height: box.height };

        gsap.set(strokeSpans, { strokeDasharray: dash, strokeDashoffset: dash, strokeOpacity: 1 });
        gsap.set(wipeRect, { attr: startFrame });

        const tl = gsap.timeline({ delay: lineDelay, defaults: { overwrite: 'auto' } });

        tl.to(strokeSpans, {
          strokeDashoffset: 0,
          duration: DRAW_DURATION,
          ease: EASE,
          stagger: STAGGER
        }, 0);

        tl.to(wipeRect, {
          attr: endFrame,
          duration: fillDuration,
          ease: 'power2.inOut'
        }, DRAW_DURATION + FILL_DELAY);

        tl.to(strokeSpans, {
          strokeOpacity: 0,
          duration: 0.35,
          ease: 'power1.out'
        }, DRAW_DURATION + FILL_DELAY + fillDuration * 0.7);

        let redrawTl: gsap.core.Timeline | null = null;
        lineEl.addEventListener('pointerenter', () => {
          if (tl.progress() < 1 || redrawTl?.isActive()) return;
          redrawTl?.kill();
          redrawTl = gsap.timeline()
            .set(strokeSpans, { strokeDashoffset: dash, strokeOpacity: 1 })
            .to(strokeSpans, {
              strokeDashoffset: 0,
              duration: DRAW_DURATION * 0.75,
              ease: EASE,
              stagger: STAGGER
            })
            .to(strokeSpans, {
              strokeOpacity: 0,
              duration: 0.3,
              ease: 'power1.out'
            });
        });
      };

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(setupAnimation).catch(setupAnimation);
      } else {
        setTimeout(setupAnimation, 50);
      }
    });
  };

  initStrokeText();
</script>

<style>
  /* TAMAÑO DE TEXTO AMPLIADO (Más grande responsivamente) */
  .stroke-text-line {
    display: inline-block;
    height: 1.22em;
    aspect-ratio: var(--stroke-text-aspect, auto);
    font-size: 2.75rem; /* 44px en móvil */
    line-height: 1;
    margin-bottom: -0.06em;
    overflow: visible;
  }

  @media (min-width: 640px) {
    .stroke-text-line {
      font-size: 3.75rem; /* 60px en sm */
    }
  }

  @media (min-width: 1024px) {
    .stroke-text-line {
      font-size: 4.5rem; /* 72px en lg */
    }
  }

  @media (min-width: 1280px) {
    .stroke-text-line {
      font-size: 5rem; /* 80px en xl - ¡Mucho más grande y imponente! */
    }
  }

  :global(.stroke-text__svg) {
    display: block;
    width: auto;
    height: 100%;
    overflow: visible;
  }

  /* Animación estilo Apple Keynote para el párrafo secundario (aparece escalonado después del título) */
  @keyframes appleSequent {
    0% {
      opacity: 0;
      transform: translateY(22px);
      filter: blur(4px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0px);
    }
  }

  @keyframes avatarEntrance {
    0% {
      opacity: 0;
      transform: translateY(30px) scale(0.96);
      filter: blur(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0px);
    }
  }

  @keyframes bounceSoft {
    0%, 100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 8px);
    }
  }

  .animate-apple-sequent {
    opacity: 0;
    animation: appleSequent 0.9s cubic-bezier(0.16, 1, 0.3, 1) 1.2s forwards;
    will-change: transform, opacity, filter;
  }

  .animate-avatar-enter {
    animation: avatarEntrance 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    will-change: transform, opacity, filter;
  }

  .animate-bounce-soft {
    animation: bounceSoft 2.2s ease-in-out infinite;
  }

  .delay-500 { animation-delay: 550ms; }
  .delay-600 { animation-delay: 700ms; }
</style>