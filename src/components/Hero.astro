---
// src/components/Hero.astro
---

<section 
  id="hero" 
  class="relative min-h-[100dvh] lg:min-h-screen flex items-center pt-20 pb-12 sm:pt-24 sm:pb-16 lg:py-0 overflow-hidden bg-slate-50 dark:bg-[#0a0a0f]"
>
  
  <!-- Luces y efectos ambientales de fondo adaptables al tema -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <div class="absolute top-[-5%] right-[-5%] w-[280px] lg:w-[500px] h-[280px] lg:h-[500px] bg-[#a100ff]/15 dark:bg-[#a100ff]/20 rounded-full blur-[90px] lg:blur-[120px] animate-pulse"></div>
    <div class="absolute bottom-[-5%] left-[-5%] w-[240px] lg:w-[450px] h-[240px] lg:h-[450px] bg-[#437ceb]/10 dark:bg-[#437ceb]/15 rounded-full blur-[80px] lg:blur-[100px]"></div>
    
    <!-- Cuadrícula técnica sutil -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#00000008_1px,transparent_1px),linear-gradient(to_bottom,#00000008_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:3rem_3rem] lg:bg-[size:3.75rem_3.75rem] [mask-image:radial-gradient(ellipse:80%_60%_at_50%_40%,#000_75%,transparent_100%)]"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 relative z-10 w-full">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-6">      
      
<!-- Columna izquierda: Textos distribuidos hacia la derecha -->
<div class="w-full lg:flex-1 flex flex-col items-center text-center lg:items-start lg:text-left max-w-xl lg:max-w-2xl xl:max-w-3xl mx-auto lg:mx-0 relative z-10 lg:ml-24 xl:ml-36 2xl:ml-48">        
  <!-- TÍTULO H1 -->
<h1 
  id="hero-stroke-heading"
  class="font-poppins font-bold tracking-tight mb-5 lg:mb-6 flex flex-col items-center lg:items-start w-full select-none"
  aria-label="El primer empleado digital para espacios físicos."
>
    <!-- Línea 1: El primer -->
    <span 
      class="stroke-text-line" 
      data-text="El primer" 
      data-stroke="#A78BFA" 
      data-fill="#111827"
      data-dark-fill="#FFFFFF"
      data-delay="0"
    ></span>

    <!-- Línea 2: empleado digital -->
    <span 
      class="stroke-text-line" 
      data-text="empleado digital" 
      data-stroke="#A78BFA" 
      data-fill="#111827"
      data-dark-fill="#FFFFFF"
      data-delay="0.18"
    ></span>

    <!-- Línea 3: para -->
    <span 
      class="stroke-text-line" 
      data-text="para" 
      data-stroke="#A78BFA" 
      data-fill="#111827"
      data-dark-fill="#FFFFFF"
      data-delay="0.36"
    ></span>

    <!-- Línea 4: espacios físicos -->
    <span 
      class="stroke-text-line" 
      data-text="espacios físicos" 
      data-stroke="#A78BFA" 
      data-fill="#437ceb"
      data-dark-fill="#437ceb"
      data-delay="0.52"
    ></span>
  </h1>
  
  <!-- Párrafo descriptivo visible y con mayor amplitud horizontal -->
  <p class="font-gilroy text-sm sm:text-base lg:text-lg text-slate-600 dark:text-gray-400 max-w-xl leading-relaxed animate-apple-sequent">
    DOMA conecta el conocimiento completo de tu empresa con un <span class="text-slate-900 dark:text-white font-semibold">empleado digital</span>, disponible 24/7. Consistente. Escalable.
  </p>

</div>

      <!-- Columna derecha: Avatar con escala visual contenida -->
      <div class="hidden lg:flex flex-1 w-full relative justify-center items-end self-end max-w-sm xl:max-w-md animate-avatar-enter delay-500">
        <div class="relative w-full flex items-end justify-center h-[380px] lg:h-[450px] xl:h-[500px]">
          
          <!-- Resplandor inferior calibrado -->
          <div class="absolute bottom-1 w-[70%] h-20 bg-gradient-to-t from-[#a100ff]/25 via-[#437ceb]/15 to-transparent rounded-full blur-xl pointer-events-none z-0"></div>

          <img 
            src="./TOTEM DOMA SITIO 3.webp" 
            alt="DOMA — Digital Sales Executive"
            class="relative z-10 w-auto h-full object-contain object-bottom brightness-105 contrast-110 drop-shadow-[0_10px_30px_rgba(67,124,235,0.25)] transition-transform duration-700 hover:scale-[1.02]"
            style="
              mix-blend-mode: screen;
              -webkit-mask-image: linear-gradient(to bottom, black 0%, black 90%, transparent 100%);
              mask-image: linear-gradient(to bottom, black 0%, black 90%, transparent 100%);
            "
          />
        </div>
      </div>

    </div>
  </div>

  <!-- FLECHA MINIMALISTA INDICADORA DE SCROLL -->
  <a 
    id="scroll-indicator"
    href="#producto"
    aria-label="Hacer scroll hacia abajo"
    class="absolute bottom-4 left-1/2 -translate-x-1/2 z-20 text-slate-400 dark:text-gray-400/70 hover:text-slate-900 dark:hover:text-white transition-all duration-500 cursor-pointer p-2 animate-bounce-soft"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 9l6 6 6-6" />
    </svg>
  </a>
</section>

<script>
  import { gsap } from 'gsap';

  // 1. Control del scroll indicator
  const scrollIndicator = document.getElementById('scroll-indicator');
  const handleScroll = () => {
    if (window.scrollY > 25) {
      scrollIndicator?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
    } else {
      scrollIndicator?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
    }
  };
  window.addEventListener('scroll', handleScroll, { passive: true });

  // 2. Parámetros ajustados de animación StrokeText
  const STROKE_WIDTH = 1.3;
  const DRAW_DURATION = 1.4;
  const FILL_DELAY = 0.15;
  const STAGGER = 0.04;
  const EASE = 'power2.out';
  const FONT_SIZE = 52; 
  const LETTER_SPACING = -1.2;

  const initStrokeText = () => {
    const lines = document.querySelectorAll('.stroke-text-line');
    const svgNS = 'http://www.w3.org/2000/svg';
    const isDark = document.documentElement.classList.contains('dark');

    lines.forEach((lineEl, lineIdx) => {
      const text = lineEl.getAttribute('data-text') || '';
      const strokeColor = lineEl.getAttribute('data-stroke') || '#A78BFA';
      const darkFill = lineEl.getAttribute('data-dark-fill') || '#FFFFFF';
      const lightFill = lineEl.getAttribute('data-fill') || '#111827';
      const fillColor = isDark ? darkFill : lightFill;
      const lineDelay = parseFloat(lineEl.getAttribute('data-delay') || '0');
      const wipeId = `stroke-text-wipe-${lineIdx}`;
      const characters = Array.from(text);

      lineEl.innerHTML = '';

      const svg = document.createElementNS(svgNS, 'svg');
      svg.setAttribute('class', 'stroke-text__svg');
      svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
      svg.setAttribute('aria-hidden', 'true');
      svg.style.visibility = 'hidden';

      const defs = document.createElementNS(svgNS, 'defs');
      const clipPath = document.createElementNS(svgNS, 'clipPath');
      clipPath.setAttribute('id', wipeId);
      clipPath.setAttribute('clipPathUnits', 'userSpaceOnUse');

      const wipeRect = document.createElementNS(svgNS, 'rect');
      clipPath.appendChild(wipeRect);
      defs.appendChild(clipPath);
      svg.appendChild(defs);

      const fontStyles = {
        fontFamily: 'inherit',
        fontSize: `${FONT_SIZE}px`,
        fontWeight: '800',
        letterSpacing: `${LETTER_SPACING}px`
      };

      const strokeText = document.createElementNS(svgNS, 'text');
      strokeText.setAttribute('class', 'stroke-text__stroke');
      strokeText.setAttribute('x', '0');
      strokeText.setAttribute('y', '0');
      strokeText.setAttribute('fill', 'none');
      strokeText.setAttribute('stroke', strokeColor);
      strokeText.setAttribute('stroke-width', String(STROKE_WIDTH));
      strokeText.setAttribute('stroke-linejoin', 'round');
      strokeText.setAttribute('stroke-linecap', 'round');
      Object.assign(strokeText.style, fontStyles);

      const strokeSpans: SVGTSpanElement[] = [];
      characters.forEach((char) => {
        const tspan = document.createElementNS(svgNS, 'tspan');
        tspan.setAttribute('data-stroke-char', 'true');
        tspan.textContent = char;
        strokeText.appendChild(tspan);
        strokeSpans.push(tspan);
      });

      const fillGroup = document.createElementNS(svgNS, 'g');
      const fillText = document.createElementNS(svgNS, 'text');
      fillText.setAttribute('class', 'stroke-text__fill');
      fillText.setAttribute('x', '0');
      fillText.setAttribute('y', '0');
      fillText.setAttribute('fill', fillColor);
      fillText.setAttribute('stroke', 'none');
      fillText.setAttribute('clip-path', `url(#${wipeId})`);
      Object.assign(fillText.style, fontStyles);

      characters.forEach((char) => {
        const tspan = document.createElementNS(svgNS, 'tspan');
        tspan.setAttribute('data-fill-char', 'true');
        tspan.textContent = char;
        fillText.appendChild(tspan);
      });

      fillGroup.appendChild(fillText);
      svg.appendChild(strokeText);
      svg.appendChild(fillGroup);
      lineEl.appendChild(svg);

      const setupAnimation = () => {
        let bbox;
        try {
          bbox = strokeText.getBBox();
        } catch {
          return;
        }
        if (!bbox || !bbox.width) return;

        const pad = Math.max(STROKE_WIDTH, FONT_SIZE * 0.1);
        const box = {
          x: bbox.x - pad,
          y: bbox.y - pad,
          width: bbox.width + pad * 2,
          height: bbox.height + pad * 2
        };

        svg.setAttribute('viewBox', `${box.x} ${box.y} ${box.width} ${box.height}`);
        (lineEl as HTMLElement).style.setProperty('--stroke-text-aspect', `${box.width / box.height}`);
        svg.style.visibility = 'visible';

        const dash = Math.max(FONT_SIZE * 6, 180);
        const fillDuration = Math.max(0.35, DRAW_DURATION * 0.45);

        const startFrame = { x: box.x, y: box.y, width: 0, height: box.height };
        const endFrame = { x: box.x, y: box.y, width: box.width, height: box.height };

        gsap.set(strokeSpans, { strokeDasharray: dash, strokeDashoffset: dash, strokeOpacity: 1 });
        gsap.set(wipeRect, { attr: startFrame });

        const tl = gsap.timeline({ 
          delay: lineDelay, 
          defaults: { overwrite: 'auto', force3D: true } 
        });

        tl.to(strokeSpans, {
          strokeDashoffset: 0,
          duration: DRAW_DURATION,
          ease: EASE,
          stagger: STAGGER,
          lazy: false
        }, 0);

        tl.to(wipeRect, {
          attr: endFrame,
          duration: fillDuration,
          ease: 'power2.inOut'
        }, DRAW_DURATION + FILL_DELAY);

        tl.to(strokeSpans, {
          strokeOpacity: 0,
          duration: 0.3,
          ease: 'power1.out'
        }, DRAW_DURATION + FILL_DELAY + fillDuration * 0.65);

        let redrawTl: gsap.core.Timeline | null = null;
        lineEl.addEventListener('pointerenter', () => {
          if (tl.progress() < 1 || redrawTl?.isActive()) return;
          redrawTl?.kill();
          redrawTl = gsap.timeline()
            .set(strokeSpans, { strokeDashoffset: dash, strokeOpacity: 1 })
            .to(strokeSpans, {
              strokeDashoffset: 0,
              duration: DRAW_DURATION * 0.7,
              ease: EASE,
              stagger: STAGGER
            })
            .to(strokeSpans, {
              strokeOpacity: 0,
              duration: 0.25,
              ease: 'power1.out'
            });
        });
      };

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(setupAnimation).catch(setupAnimation);
      } else {
        setTimeout(setupAnimation, 50);
      }
    });
  };

  initStrokeText();

  const themeBtn = document.getElementById('theme-toggle');
  themeBtn?.addEventListener('click', () => {
    setTimeout(initStrokeText, 50);
  });
</script>

<style>
  /* Interlineado ajustado y alturas proporcionadas */
  .stroke-text-line {
    display: block;
    height: 1.05em; /* Altura compacta para evitar separación excesiva */
    aspect-ratio: var(--stroke-text-aspect, auto);
    font-size: 2.25rem; /* ~36px en móviles */
    line-height: 1;
    margin-bottom: -0.1em; /* Margen negativo controlado para juntar las líneas sin romper el flujo */
    overflow: visible;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
    will-change: transform, opacity;
  }

  @media (min-width: 640px) {
    .stroke-text-line {
      font-size: 2.85rem;
      margin-bottom: -0.1em;
    }
  }

  @media (min-width: 1024px) {
    .stroke-text-line {
      font-size: 3.4rem;
      margin-bottom: -0.12em;
    }
  }

  @media (min-width: 1280px) {
    .stroke-text-line {
      font-size: 3.85rem;
      margin-bottom: -0.19em;
    }
  }

  :global(.stroke-text__svg) {
    display: block;
    width: auto;
    height: 100%;
    overflow: visible;
    transform: translate3d(0, 0, 0);
    -webkit-transform: translate3d(0, 0, 0);
  }

  @keyframes appleSequent {
    0% {
      opacity: 0;
      transform: translateY(16px);
      filter: blur(4px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0px);
    }
  }

  @keyframes avatarEntrance {
    0% {
      opacity: 0;
      transform: translateY(24px) scale(0.97);
      filter: blur(8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0px);
    }
  }

  @keyframes bounceSoft {
    0%, 100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 6px);
    }
  }

  .animate-apple-sequent {
    opacity: 0;
    animation: appleSequent 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1s forwards;
    will-change: transform, opacity, filter;
  }

  .animate-avatar-enter {
    animation: avatarEntrance 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    will-change: transform, opacity, filter;
  }

  .animate-bounce-soft {
    animation: bounceSoft 2.2s ease-in-out infinite;
  }

  .delay-500 { animation-delay: 450ms; }
</style>