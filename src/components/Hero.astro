---
// src/components/Hero.astro
---

<section 
  id="hero" 
  class="relative min-h-[68vh] sm:min-h-[72vh] lg:min-h-[75vh] xl:min-h-[78vh] flex items-center pt-20 pb-4 sm:pt-24 sm:pb-6 lg:pt-24 lg:pb-8 overflow-hidden bg-slate-50 dark:bg-[#0a0a0f]"
>
  
  <!-- Luces y efectos ambientales estáticos acelerados por GPU -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <div 
      class="absolute top-[-5%] right-[-5%] w-[260px] lg:w-[420px] h-[260px] lg:h-[420px] bg-[#a100ff]/15 dark:bg-[#a100ff]/20 rounded-full blur-[80px] lg:blur-[100px]"
      style="transform: translateZ(0);"
    ></div>
    <div 
      class="absolute bottom-[-5%] left-[-5%] w-[220px] lg:w-[380px] h-[220px] lg:h-[380px] bg-[#437ceb]/10 dark:bg-[#437ceb]/15 rounded-full blur-[70px] lg:blur-[90px]"
      style="transform: translateZ(0);"
    ></div>
    
    <!-- Cuadrícula técnica sutil -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#00000008_1px,transparent_1px),linear-gradient(to_bottom,#00000008_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:3rem_3rem] lg:bg-[size:3.75rem_3.75rem] [mask-image:radial-gradient(ellipse:80%_60%_at_50%_40%,#000_75%,transparent_100%)]"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 relative z-10 w-full">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-6 lg:gap-8 max-w-6xl mx-auto">      
      
      <!-- Columna izquierda: Textos -->
      <div class="w-full lg:flex-[1.2] flex flex-col items-center text-center lg:items-start lg:text-left max-w-xl lg:max-w-2xl relative z-10">        
        
        <!-- TÍTULO H1: Poppins ExtraBold -->
        <h1 
          id="hero-stroke-heading"
          class="font-poppins font-extrabold tracking-tight mb-3 lg:mb-4 flex flex-col items-center lg:items-start w-full select-none"
          aria-label="El empleado digital para el mundo físico"
        >
          <!-- Línea 1: El empleado digital -->
          <span 
            class="stroke-text-line" 
            data-text="El empleado digital" 
            data-stroke="#A78BFA" 
            data-fill="#111827"
            data-dark-fill="#FFFFFF"
            data-delay="0"
          ></span>

          <!-- Línea 2: para el mundo físico -->
          <span 
            class="stroke-text-line" 
            data-text="para el mundo físico" 
            data-stroke="#A78BFA" 
            data-fill="#437ceb"
            data-dark-fill="#437ceb"
            data-delay="0.25"
          ></span>
        </h1>
        
        <!-- Párrafo descriptivo -->
        <p class="font-gilroy font-normal text-sm sm:text-base lg:text-lg text-slate-600 dark:text-gray-400 max-w-xl leading-relaxed animate-apple-sequent">
          Una experiencia de atención que combina <span class="text-slate-900 dark:text-white font-semibold">inteligencia y conversación natural</span> con la información y operación de tu empresa.
        </p>

      </div>

     <!-- Columna derecha: Tótem DOMA optimizado con fade inferior invisible -->
<div class="hidden lg:flex flex-1 w-full relative justify-center items-end self-end max-w-md xl:max-w-lg animate-avatar-enter">
  <div 
    class="relative w-full flex items-end justify-center h-[380px] lg:h-[440px] xl:h-[500px] overflow-hidden"
    style="
      -webkit-mask-image: linear-gradient(to bottom, black 75%, transparent 100%);
      mask-image: linear-gradient(to bottom, black 75%, transparent 100%);
    "
  >
    <img 
      id="hero-totem-image"
      src="/TOTEM DOMA SITIO 3.webp" 
      alt="Tótem DOMA Inteligencia Artificial"
      width="500"
      height="600"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="relative z-10 w-auto h-full object-contain object-bottom drop-shadow-[0_15px_35px_rgba(0,0,0,0.18)] dark:drop-shadow-[0_20px_45px_rgba(161,0,255,0.22)] transition-transform duration-500 hover:scale-[1.02]"
      style="transform: translateZ(0); -webkit-backface-visibility: hidden;"
    />

    <!-- Overlay complementario para asegurar una transición imperceptible con el fondo -->
    <div class="absolute bottom-0 inset-x-0 h-16 bg-gradient-to-t from-slate-50 dark:from-[#0a0a0f] to-transparent pointer-events-none z-20"></div>
  </div>
</div>

    </div>
  </div>


</section>

<script>
  import { gsap } from 'gsap';

  // 1. Manejo del indicador de scroll
  const scrollIndicator = document.getElementById('scroll-indicator');
  const handleScroll = () => {
    if (window.scrollY > 25) {
      scrollIndicator?.classList.add('opacity-0', 'pointer-events-none');
    } else {
      scrollIndicator?.classList.remove('opacity-0', 'pointer-events-none');
    }
  };
  window.addEventListener('scroll', handleScroll, { passive: true });

  // 2. Parámetros ajustados de animación StrokeText
  const STROKE_WIDTH = 1.8;
  const DRAW_DURATION = 1.2;
  const FILL_DELAY = 0.12;
  const STAGGER = 0.035;
  const EASE = 'power2.out';
  const FONT_SIZE = 82;
  const LETTER_SPACING = -1.5;

  const initStrokeText = () => {
    const lines = document.querySelectorAll('.stroke-text-line');
    const svgNS = 'http://www.w3.org/2000/svg';
    const isDark = document.documentElement.classList.contains('dark');

    lines.forEach((lineEl, lineIdx) => {
      const text = lineEl.getAttribute('data-text') || '';
      if (!text.trim()) return;

      const strokeColor = lineEl.getAttribute('data-stroke') || '#A78BFA';
      const darkFill = lineEl.getAttribute('data-dark-fill') || '#FFFFFF';
      const lightFill = lineEl.getAttribute('data-fill') || '#111827';
      const fillColor = isDark ? darkFill : lightFill;
      const lineDelay = parseFloat(lineEl.getAttribute('data-delay') || '0');
      const wipeId = `stroke-text-wipe-${lineIdx}`;
      const characters = Array.from(text);

      lineEl.innerHTML = '';

      const svg = document.createElementNS(svgNS, 'svg');
      svg.setAttribute('class', 'stroke-text__svg');
      svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
      svg.setAttribute('aria-hidden', 'true');
      svg.style.visibility = 'hidden';

      const defs = document.createElementNS(svgNS, 'defs');
      const clipPath = document.createElementNS(svgNS, 'clipPath');
      clipPath.setAttribute('id', wipeId);
      clipPath.setAttribute('clipPathUnits', 'userSpaceOnUse');

      const wipeRect = document.createElementNS(svgNS, 'rect');
      clipPath.appendChild(wipeRect);
      defs.appendChild(clipPath);
      svg.appendChild(defs);

      const fontStyles = {
        fontFamily: "'Poppins', sans-serif",
        fontSize: `${FONT_SIZE}px`,
        fontWeight: '800',
        letterSpacing: `${LETTER_SPACING}px`
      };

      const strokeText = document.createElementNS(svgNS, 'text');
      strokeText.setAttribute('class', 'stroke-text__stroke');
      strokeText.setAttribute('x', '0');
      strokeText.setAttribute('y', '0');
      strokeText.setAttribute('fill', 'none');
      strokeText.setAttribute('stroke', strokeColor);
      strokeText.setAttribute('stroke-width', String(STROKE_WIDTH));
      strokeText.setAttribute('stroke-linejoin', 'round');
      strokeText.setAttribute('stroke-linecap', 'round');
      Object.assign(strokeText.style, fontStyles);

      const strokeSpans: SVGTSpanElement[] = [];
      characters.forEach((char) => {
        const tspan = document.createElementNS(svgNS, 'tspan');
        tspan.setAttribute('data-stroke-char', 'true');
        tspan.textContent = char;
        strokeText.appendChild(tspan);
        strokeSpans.push(tspan);
      });

      const fillGroup = document.createElementNS(svgNS, 'g');
      const fillText = document.createElementNS(svgNS, 'text');
      fillText.setAttribute('class', 'stroke-text__fill');
      fillText.setAttribute('x', '0');
      fillText.setAttribute('y', '0');
      fillText.setAttribute('fill', fillColor);
      fillText.setAttribute('stroke', 'none');
      fillText.setAttribute('clip-path', `url(#${wipeId})`);
      Object.assign(fillText.style, fontStyles);

      characters.forEach((char) => {
        const tspan = document.createElementNS(svgNS, 'tspan');
        tspan.setAttribute('data-fill-char', 'true');
        tspan.textContent = char;
        fillText.appendChild(tspan);
      });

      fillGroup.appendChild(fillText);
      svg.appendChild(strokeText);
      svg.appendChild(fillGroup);
      lineEl.appendChild(svg);

      const setupAnimation = () => {
        let bbox;
        try {
          bbox = strokeText.getBBox();
        } catch {
          return;
        }
        if (!bbox || !bbox.width) return;

        // Cálculos corregidos con operadores válidos
        const pad = Math.max(STROKE_WIDTH, FONT_SIZE * 0.1);
        const box = {
          x: bbox.x - pad,
          y: bbox.y - pad,
          width: bbox.width + pad * 2,
          height: bbox.height + pad * 2
        };

        svg.setAttribute('viewBox', `${box.x} ${box.y} ${box.width} ${box.height}`);
        (lineEl as HTMLElement).style.setProperty('--stroke-text-aspect', `${box.width / box.height}`);
        svg.style.visibility = 'visible';

        const dash = Math.max(FONT_SIZE * 5, 180);
        const fillDuration = Math.max(0.35, DRAW_DURATION * 0.45);

        const startFrame = { x: box.x, y: box.y, width: 0, height: box.height };
        const endFrame = { x: box.x, y: box.y, width: box.width, height: box.height };

        gsap.set(strokeSpans, { strokeDasharray: dash, strokeDashoffset: dash, strokeOpacity: 1 });
        gsap.set(wipeRect, { attr: startFrame });

        const tl = gsap.timeline({ 
          delay: lineDelay, 
          defaults: { overwrite: 'auto', force3D: true } 
        });

        tl.to(strokeSpans, {
          strokeDashoffset: 0,
          duration: DRAW_DURATION,
          ease: EASE,
          stagger: STAGGER,
          lazy: false
        }, 0);

        tl.to(wipeRect, {
          attr: endFrame,
          duration: fillDuration,
          ease: 'power2.inOut'
        }, DRAW_DURATION + FILL_DELAY);

        tl.to(strokeSpans, {
          strokeOpacity: 0,
          duration: 0.25,
          ease: 'power1.out'
        }, DRAW_DURATION + FILL_DELAY + fillDuration * 0.6);

        let redrawTl: gsap.core.Timeline | null = null;
        lineEl.addEventListener('pointerenter', () => {
          if (tl.progress() < 1 || redrawTl?.isActive()) return;
          redrawTl?.kill();
          redrawTl = gsap.timeline()
            .set(strokeSpans, { strokeDashoffset: dash, strokeOpacity: 1 })
            .to(strokeSpans, {
              strokeDashoffset: 0,
              duration: DRAW_DURATION * 0.7,
              ease: EASE,
              stagger: STAGGER
            })
            .to(strokeSpans, {
              strokeOpacity: 0,
              duration: 0.25,
              ease: 'power1.out'
            });
        });
      };

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(setupAnimation).catch(setupAnimation);
      } else {
        setTimeout(setupAnimation, 50);
      }
    });
  };

  initStrokeText();

  // Re-renderizado del texto al alternar el modo oscuro
  const themeBtn = document.getElementById('theme-toggle');
  themeBtn?.addEventListener('click', () => {
    setTimeout(initStrokeText, 80);
  });
</script>

<style>
  .stroke-text-line {
    font-family: 'Poppins', sans-serif;
    font-weight: 800;
    display: block;
    height: 1.05em;
    aspect-ratio: var(--stroke-text-aspect, auto);
    font-size: 2.75rem; 
    line-height: 1;
    margin-bottom: -0.08em;
    overflow: visible;
    transform: translate3d(0, 0, 0);
    -webkit-transform: translate3d(0, 0, 0);
    will-change: transform, opacity;
  }

  @media (min-width: 640px) {
    .stroke-text-line {
      font-size: 3.5rem;
      margin-bottom: -0.1em;
    }
  }

  @media (min-width: 1024px) {
    .stroke-text-line {
      font-size: 4.25rem;
      margin-bottom: -0.12em;
    }
  }

  @media (min-width: 1280px) {
    .stroke-text-line {
      font-size: 5rem;
      margin-bottom: -0.14em;
    }
  }

  :global(.stroke-text__svg) {
    display: block;
    width: auto;
    height: 100%;
    overflow: visible;
    transform: translate3d(0, 0, 0);
    -webkit-transform: translate3d(0, 0, 0);
  }

  /* Animaciones puras basadas en transform y opacity para aceleración en GPU */
  @keyframes appleSequent {
    0% {
      opacity: 0;
      transform: translate3d(0, 14px, 0);
    }
    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes avatarEntrance {
    0% {
      opacity: 0;
      transform: translate3d(0, 20px, 0) scale(0.98);
    }
    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes bounceSoft {
    0%, 100% {
      transform: translate3d(-50%, 0, 0);
    }
    50% {
      transform: translate3d(-50%, 4px, 0);
    }
  }

  .animate-apple-sequent {
    opacity: 0;
    animation: appleSequent 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
    will-change: transform, opacity;
  }

  .animate-avatar-enter {
    opacity: 0;
    animation: avatarEntrance 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    will-change: transform, opacity;
  }

  .animate-bounce-soft {
    animation: bounceSoft 2.2s ease-in-out infinite;
  }
</style>