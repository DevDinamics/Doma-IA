---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="relative pb-20 px-4 sm:px-6 bg-slate-50 dark:bg-[#0a0a0f] overflow-hidden">
  
  {/* 1. EL GLOW DE FONDO (Colores de DOMA: Púrpura y Azul) */}
  <div class="absolute bottom-0 left-0 right-0 h-[500px] bg-gradient-to-t from-[#a100ff]/10 via-[#437ceb]/5 to-transparent pointer-events-none"></div>
  <div class="absolute -bottom-20 -left-20 w-[400px] h-[400px] bg-[#a100ff]/15 dark:bg-[#a100ff]/20 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute -bottom-20 -right-20 w-[400px] h-[400px] bg-[#437ceb]/10 dark:bg-[#437ceb]/15 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    
    {/* 2. LA TARJETA PRINCIPAL (Estilo Over Glow adaptable) */}
    <div class="bg-white/85 dark:bg-[#0f0f15]/80 backdrop-blur-3xl border border-slate-200/80 dark:border-white/5 rounded-[40px] p-8 md:p-16 shadow-[0_20px_50px_rgba(0,0,0,0.06)] dark:shadow-2xl overflow-hidden relative z-20 group">
      
      {/* Resplandor interior sutil */}
      <div class="absolute inset-0 bg-gradient-to-br from-black/[0.02] to-transparent dark:from-white/[0.02] dark:to-transparent pointer-events-none"></div>

      {/* Top Section: Logo y Descripción (CENTRADOS Y EN UNA LÍNEA) */}
      <div class="flex flex-col items-center justify-center text-center mb-20 gap-5 relative z-30">
        {/* LOGO EN IMAGEN */}
        <a href="/" class="inline-block relative z-40 mb-2">
            <img 
              src="/Logo_domanav.png" 
              alt="DOMA Logo" 
              class="h-6 md:h-8 w-auto object-contain brightness-0 dark:brightness-100 transition-[filter] duration-300"
            />
        </a>
        
        {/* Texto descriptivo distribuido en una línea */}
        <p class="font-gilroy font-normal text-slate-700 dark:text-gray-300 text-lg md:text-xl w-full sm:whitespace-nowrap leading-relaxed relative z-40">
            El empleado digital para el mundo físico
        </p>
        
        {/* Etiqueta Hecho en México */}
        <span class="text-[#a100ff] text-xs font-bold uppercase tracking-[0.2em] relative z-40">
            Hecho en México
        </span>
      </div>

      {/* Grid de Links */}
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-12 mb-20 relative z-30">
        
        {/* COLUMNA: PRODUCTO */}
        <div class="relative z-40">
          <h4 class="font-gilroy font-bold text-slate-900 dark:text-white uppercase tracking-[0.2em] text-xs mb-8">Producto</h4>
          <ul class="space-y-4">
            <li><a href="#advisor" class="font-gilroy font-normal text-slate-600 hover:text-[#a100ff] dark:text-gray-400 dark:hover:text-[#a100ff] transition-colors text-sm">DOMA Advisor</a></li>
            <li><a href="#guide" class="font-gilroy font-normal text-slate-600 hover:text-[#a100ff] dark:text-gray-400 dark:hover:text-[#a100ff] transition-colors text-sm">DOMA Guide</a></li>
            <li><a href="#concierge" class="font-gilroy font-normal text-slate-600 hover:text-[#a100ff] dark:text-gray-400 dark:hover:text-[#a100ff] transition-colors text-sm">DOMA Concierge</a></li>
            <li><a href="#host" class="font-gilroy font-normal text-slate-600 hover:text-[#a100ff] dark:text-gray-400 dark:hover:text-[#a100ff] transition-colors text-sm">DOMA Host</a></li>
          </ul>
        </div>

        {/* COLUMNA: INDUSTRIAS */}
        <div class="relative z-40">
          <h4 class="font-gilroy font-bold text-slate-900 dark:text-white uppercase tracking-[0.2em] text-xs mb-8">Industrias</h4>
          <ul class="space-y-4">
            <li><a href="#industrias" class="font-gilroy font-normal text-slate-600 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors text-sm">Retail & Mall</a></li>
            <li><a href="#industrias" class="font-gilroy font-normal text-slate-600 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors text-sm">Transporte & Hospitalidad</a></li>
            <li><a href="#industrias" class="font-gilroy font-normal text-slate-600 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors text-sm">Banca & Seguros</a></li>
          </ul>
        </div>

        {/* COLUMNA: EMPRESA */}
        <div class="relative z-40">
          <h4 class="font-gilroy font-bold text-slate-900 dark:text-white uppercase tracking-[0.2em] text-xs mb-8">Empresa</h4>
          <ul class="space-y-4">
            <li><a href="#" class="font-gilroy font-normal text-slate-600 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors text-sm">Sobre DOMA</a></li>
            <li><a href="#faq" class="font-gilroy font-normal text-slate-600 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors text-sm">FAQ</a></li>
            <li><a href="mailto:hola@doma.ai" class="font-gilroy font-normal text-slate-600 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors text-sm">Contacto</a></li>
          </ul>
        </div>

        {/* COLUMNA: SOCIAL */}
        <div class="relative z-40">
          <h4 class="font-gilroy font-bold text-slate-900 dark:text-white uppercase tracking-[0.2em] text-xs mb-8">Social</h4>
          <div class="flex gap-4 mb-8">
            {/* Botones Sociales más grandes y visibles */}
            <a href="https://www.linkedin.com/company/domahumans/" class="w-12 h-12 rounded-xl border border-slate-300 dark:border-white/20 bg-slate-200/50 dark:bg-white/10 flex items-center justify-center text-slate-900 dark:text-white hover:bg-[#a100ff] hover:text-white hover:border-[#a100ff] hover:-translate-y-1 transition-all duration-300 relative z-50 cursor-pointer shadow-sm dark:shadow-none" aria-label="LinkedIn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="pointer-events-none"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="https://www.instagram.com/doma.humans/" class="w-12 h-12 rounded-xl border border-slate-300 dark:border-white/20 bg-slate-200/50 dark:bg-white/10 flex items-center justify-center text-slate-900 dark:text-white hover:bg-[#437ceb] hover:text-white hover:border-[#437ceb] hover:-translate-y-1 transition-all duration-300 relative z-50 cursor-pointer shadow-sm dark:shadow-none" aria-label="Instagram">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
          </div>
          
          <a href="https://wa.me/5213310736395?text=%C2%A1Hola!%20Me%20interesa%20agendar%20una%20demo%20de%20DOMA." class="inline-block font-poppins font-semibold text-[#a100ff] hover:text-[#437ceb] transition-all underline underline-offset-8 text-sm relative z-50 cursor-pointer">
            Agendar Demo
          </a>
        </div>
      </div>

      {/* Bottom Bar: Copyright Actualizado */}
      <div class="pt-8 border-t border-slate-200/80 dark:border-white/5 flex flex-col md:flex-row justify-between items-center gap-6 relative z-30">
        <div class="flex w-full items-center justify-center relative z-40">
            <p class="font-gilroy font-normal text-slate-500 dark:text-gray-500 text-sm text-center">
                © {currentYear} DOMA. Todos los derechos reservados.
            </p>
        </div>
      </div>

    </div>

  </div>
</footer>